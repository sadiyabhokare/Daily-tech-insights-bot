    {
      "parameters": {
        "jsCode": "// Pehle check karo kya mil raha hai\nconst item = items[0].json;\n\n// Headlines alag se lena\nconst headlines = item.headlines || [];\n\n// Quote seedha ZenQuotes se fetch karna\nlet quoteText = 'Keep building, keep growing.';\nlet quoteAuthor = 'Unknown';\n\ntry {\n  const quoteResponse = await $http.request({\n    method: 'GET',\n    url: 'https://zenquotes.io/api/today',\n  });\n  const quoteData = Array.isArray(quoteResponse) ? quoteResponse[0] : quoteResponse;\n  quoteText = quoteData.q || quoteText;\n  quoteAuthor = quoteData.a || quoteAuthor;\n} catch(e) {\n  // fallback quote rehega\n}\n\nconst days = ['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'];\nconst months = ['January','February','March','April','May','June','July','August','September','October','November','December'];\nconst now = new Date();\nconst dateStr = `${days[now.getDay()]}, ${now.getDate()} ${months[now.getMonth()]} ${now.getFullYear()}`;\n\nlet newsSection = '';\nheadlines.forEach((h, i) => {\n  newsSection += `${i + 1}. ${h.title}\\n   → ${h.link}\\n\\n`;\n});\n\nconst message = `🚀 *Daily Tech Insights — ${dateStr}*\\n\\n💡 *Quote of the Day:*\\n_\"${quoteText}\"_\\n— ${quoteAuthor}\\n\\n📰 *Top Tech Headlines Today:*\\n\\n${newsSection}Stay curious & keep building! 💪`;\n\nreturn [{ json: { message } }];"
      },
